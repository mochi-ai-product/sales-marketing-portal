// Sales & Marketing Portal - data model
// Status: placeholder only. The real domain model (campaigns, funnel stages,
// per-vertical fields) will be shaped by the product brief from the
// Sales & Marketing Product Manager (see MOCAAAAAAAA-4). This starter model
// exists to prove the DB -> API -> UI pipeline end to end and to give other
// portals/AI Enablement a concrete convention to integrate against:
//   - cuid() ids, camelCase fields, explicit createdAt/updatedAt on every model.
//
// Multi-tenancy: single-DB, organizationId-scoped rows (company-wide
// convention decided MOCAAAAAAAA-25, same pattern as Talent Management's
// CONTRACT.md). organizationId is the tenant id owned by Talent Management
// (source of truth for Organization) - stored here as a plain scoped column,
// not a cross-service foreign key. Every model added to this schema going
// forward must carry organizationId + an index on it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String
  phone          String?
  source         String? // e.g. "website", "referral", "campaign:<id>"
  status         String   @default("new") // new | contacted | qualified | won | lost
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales Sale[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

// Product/service catalog (MOCAAAAAAAA-64). Owner/staff define priced
// treatments/packages here so sales are logged as real line items instead of
// free-text amounts (prerequisite for the Epic 3 extension, MOCAAAAAAAA-66).
//
// `active = false` is a soft-deactivate, not a delete: it hides the product
// from new-sale selection but the row (and its id) must stay intact forever,
// because downstream sale line items are expected to snapshot `name`/
// `priceCents` at time of sale rather than live-reference this row - a later
// edit or deactivation here must never rewrite historical revenue.
//
// Money is stored as integer cents (`priceCents`), not a float/Decimal, to
// avoid rounding drift - display-format by dividing by 100 in the UI layer.
model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  priceCents     Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  saleLineItems SaleLineItem[]

  @@index([organizationId])
  @@index([organizationId, active])
}

// Priced sales-transaction line items (MOCAAAAAAAA-66): a lead/appointment
// converting into a sale creates one Sale linked to the Lead, with one or
// more SaleLineItem rows - replacing a free-text sale amount with real,
// per-product-priced records. `Sale.totalCents` is a stored sum of its line
// items (recomputed at creation, never edited independently) so the Epic 4
// funnel dashboard can read revenue straight off `Sale` without re-deriving
// it from line items on every query.
model Sale {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  totalCents     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead      Lead           @relation(fields: [leadId], references: [id])
  lineItems SaleLineItem[]

  @@index([organizationId])
  @@index([leadId])
}

// Snapshots productNameSnapshot/unitPriceCentsSnapshot from the referenced
// Product at the moment of sale (per MOCAAAAAAAA-64) - these fields are
// never recomputed from a live Product row, so later price edits or
// deactivation on Product never rewrite historical revenue. `productId`
// stays as a foreign key purely for referential integrity/traceability
// (Product rows are soft-deactivated, never deleted, so this FK never
// dangles); no read path may join through it to get current pricing.
model SaleLineItem {
  id                     String   @id @default(cuid())
  organizationId         String
  saleId                 String
  productId              String
  productNameSnapshot    String
  unitPriceCentsSnapshot Int
  quantity               Int
  lineTotalCents         Int
  createdAt              DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([organizationId])
  @@index([saleId])
}
