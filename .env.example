DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sales_marketing?schema=public"

# Shared JWT auth (@ad-tech/auth-verify, vendored at libs/auth-verify - see MOCAAAAAAAA-33).
# AUTH_ISSUER / AUTH_AUDIENCE are always required once customer-facing routes use src/lib/auth.ts.
# AUTH_JWKS_URL is the production WorkOS AuthKit JWKS endpoint (not provisioned yet - MOCAAAAAAAA-27).
# AUTH_DEV_SHARED_SECRET is for local/CI only; the verifier refuses it when NODE_ENV=production.
AUTH_ISSUER="https://auth.ad-technologies.test/"
AUTH_AUDIENCE="ad-tech-portals"
AUTH_JWKS_URL=""
AUTH_DEV_SHARED_SECRET="dev-only-shared-secret-not-for-production"
