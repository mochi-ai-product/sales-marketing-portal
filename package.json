    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "prisma": "^5.20.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
